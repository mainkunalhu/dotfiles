{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  // Slim setup: image on the left, ~10 lines on the right so it fits the Geto art.
  // Ghostty / Kitty / WezTerm use kitty graphics. No kitty support? -> "chafa".
  "logo": {
    "source": "~/.config/fastfetch/assets/geto-rounded.png",
    "type": "kitty",
    "width": 30,
    "padding": {
      "top": 1,
      "left": 2,
      "right": 4
    }
  },
  "display": {
    "separator": ": "
  },
  "modules": [
    "title",
    "separator",
    "os",
    "uptime",
    "shell",
    "terminal",
    "cpu",
    "memory",
    "disk",
    {
      "type": "command",
      "key": "Directory",
      "text": "pwd"
    },
    "break",
    "colors"
  ]
}
